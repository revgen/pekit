show_usage() { sed -n '/^##/,/^$/s/^## \{0,1\}//p' "$0" | sed 's/{SCRIPT_NAME}/'"${0##*/}"'/g'; }

update() {
    echo "TBD"
}

# ----------------------------------------------------------------------------
case "${1:-"--help"}" in
    help|--help) show_usage; exit 1;;
    logo) show_logo; exit 0;;
    version|--version|-v) echo "${name} ${version}"; exit 0;;
    *) echo "Error: unknown '${1}' command."; exit 1;;
esac
